# 複製成 .env 後填入實值（.env 已被 gitignore，請勿 commit）

# Postgres 連線字串
#   本機 docker compose：postgresql://cmuh:cmuh_local_dev@localhost:5432/cmuh_dt
#   本機 brew postgres ：postgresql://<你的使用者>@localhost:5432/cmuh_dt
#   Azure Flexible Server：postgresql://<admin>:<password>@<server>.postgres.database.azure.com:5432/cmuh_dt?sslmode=require
DATABASE_URL=

# session 與遊戲簽章用的密鑰，至少 32 bytes 隨機值：openssl rand -hex 32
SESSION_SECRET=

# 選填：seed 建立講師帳號時的初始密碼；不填則每位講師隨機產生，只印一次並寫入 .seed-output.local.txt
INSTRUCTOR_INITIAL_PASSWORD=

# Azure Blob 連線字串
#   本機 Azurite 使用 Microsoft 公開的開發用預設值：
#   DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=<Azurite 文件中的預設金鑰>;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
#   Azure：az storage account show-connection-string -g <rg> -n <account>
AZURE_STORAGE_CONNECTION_STRING=

# private container 名稱
AZURE_STORAGE_CONTAINER=resources

# 主站網址（決定 cookie 是否加 Secure、遊戲 frame-ancestors）
#   本機：http://localhost:3000    Azure：https://<app>.azurewebsites.net
APP_ORIGIN=http://localhost:3000

# 選填：HTML 遊戲的獨立 origin（例如第二個 hostname）。留空＝同站 /play 路徑＋CSP sandbox
GAME_ORIGIN=

# 監聽埠（Azure App Service 會自動帶入 PORT）
PORT=3000
